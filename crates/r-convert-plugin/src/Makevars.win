# Windows build. Everything here mirrors `Makevars` except the target triple, and
# that one difference is the whole reason this file exists.
#
# R on Windows links with Rtools' mingw-w64 toolchain, which expects the GNU ABI.
# Cargo's default target on a Windows host is `x86_64-pc-windows-msvc`, so without
# an explicit `--target` the archive is MSVC-ABI and the link fails on CRT
# intrinsics the GNU runtime has no definition for:
#
#     ld.exe: libfastsasconvert.a(std...): undefined reference to `__chkstk'
#     collect2.exe: error: ld returned 1 exit status
#
# Naming the target also moves the output: cargo writes to
# `target/<triple>/release` rather than `target/release`, so LIBDIR follows it.

# R-universe sets CARGO_BUILD_TARGET when it cross-builds — Windows arm64 gets
# `aarch64-pc-windows-gnullvm` — so deferring to it keeps LIBDIR pointing at
# whatever cargo actually wrote. Failing that, pick the ABI the way rextendr's own
# `tools/config.R` does: a clang-based Rtools wants gnullvm, a gcc-based one gnu.
ifneq (,$(findstring clang,$(R_COMPILED_BY)))
  DEFAULT_TARGET = x86_64-pc-windows-gnullvm
else
  DEFAULT_TARGET = x86_64-pc-windows-gnu
endif
TARGET = $(if $(CARGO_BUILD_TARGET),$(CARGO_BUILD_TARGET),$(DEFAULT_TARGET))

TARGET_DIR = $(CURDIR)/rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/release
STATLIB = $(LIBDIR)/libfastsasconvert.a

# When rustc drives a link it passes these itself; here R drives it, so the system
# libraries Rust's windows-gnu std depends on have to be named explicitly.
#
# `-Wl,-x -Wl,-S` discard local symbols and debug info; see `Makevars` for why the
# strip has to happen at link time rather than in cargo's profile, and for the sizes.
PKG_LIBS = -L$(LIBDIR) -lfastsasconvert -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll -Wl,-x -Wl,-S

CARGO_BUILD_ARGS = --lib --release --target=$(TARGET) --manifest-path=$(CURDIR)/rust/Cargo.toml --target-dir $(TARGET_DIR)

# Rust's windows-gnu std asks the linker for `-lgcc_eh`, which Rtools' static.posix
# mingw does not ship under that name. An empty archive satisfies the reference
# without contributing anything — the same stub rextendr's template creates.
LIBGCC_MOCK = $(TARGET_DIR)/libgcc_mock

$(SHLIB): $(STATLIB)

# See `Makevars` for why cargo runs from `rust/` (it walks up to `../.cargo`), why
# this is forced rather than a bare rule (make would otherwise link a stale archive
# on an in-place install), and what the vendor step below is for.
#
# `rustup target add` is best-effort and reaches the network when the target is not
# already installed. That is fine here and on R-universe, but a CRAN build machine
# has no network: it must already carry the windows-gnu target, and the `|| true`
# is what keeps a missing rustup from failing the build outright rather than a
# guarantee that the target is present.
#
# The two restrictions below apply only on the vendored path, which is exactly the
# path a released tarball takes, and they are both CRAN requirements:
#
#   CARGO_HOME  cargo writes its registry cache and git checkouts to ~/.cargo by
#               default. CRAN forbids writing anywhere outside the build directory,
#               so it is redirected under `target/`, which `clean` already removes.
#   --jobs 2    cargo ignores make's `-j` and spawns one job per logical CPU, which
#               oversubscribes a shared build machine. CRAN asks for at most two.
#
# Neither is applied when building from the repository, where there is no tarball:
# a fresh CARGO_HOME would re-download the whole registry on every install, and
# capping a developer's cores at two is a cost with nothing to buy.
$(STATLIB): FORCE
	# `R CMD check` fails "checking Rust compilation" with "No rustc version
	# reported prior to compilation" unless the toolchain identifies itself in the
	# install log. CRAN wants this on record for every Rust package.
	rustc --version && cargo --version
	mkdir -p "$(LIBGCC_MOCK)"
	touch "$(LIBGCC_MOCK)/libgcc_eh.a"
	cd rust && rustup target add $(TARGET) || true
	if [ -f rust/vendor.tar.xz ]; then \
	  tar -xf rust/vendor.tar.xz -C rust && \
	  mkdir -p rust/.cargo && \
	  printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "vendor"\n' > rust/.cargo/config.toml; \
	fi
	cd rust && \
	  export LIBRARY_PATH="$(LIBRARY_PATH);$(LIBGCC_MOCK)" && \
	  if [ -d vendor ]; then \
	    CARGO_HOME="$(TARGET_DIR)/cargo-home" && export CARGO_HOME && \
	    mkdir -p "$$CARGO_HOME" && \
	    cargo build $(CARGO_BUILD_ARGS) --offline --jobs 2; \
	  else \
	    cargo build $(CARGO_BUILD_ARGS); \
	  fi

C_clean:
	rm -Rf $(LIBDIR)/build

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) rust/target rust/vendor rust/.cargo

FORCE:

.PHONY: C_clean clean FORCE
