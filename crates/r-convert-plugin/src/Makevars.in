TARGET_DIR = $(CURDIR)/rust/target
LIBDIR = $(TARGET_DIR)/release
STATLIB = $(LIBDIR)/libfastsasconvert.a

# This file is a template. `../configure` substitutes @STRIP_FLAGS@ with whichever
# of `-Wl,-x`, `-Wl,-S`, `-Wl,--gc-sections` and `-Wl,-dead_strip` the platform's
# linker actually accepts, and writes `Makevars`. Edit this file, never that one.
#
# Discarding local symbols at link time is where this package's installed size comes
# down — 8.15 MB to 4.07 MB on macOS, and from over to under the 5 MB that
# `R CMD check` NOTEs on Linux. It has to happen here rather than in cargo's profile:
# `-Cstrip` runs at link time and a `staticlib` never links, so setting `strip` in
# `rust/Cargo.toml` is silently a no-op (measured: 368 bytes of 5.2 MB).
#
# Only locals are discarded, so the exported entry points are unaffected;
# `R_init_fastsasconvert` and the extendr metadata symbol were checked afterwards on
# both ELF and Mach-O.
PKG_LIBS = -L$(LIBDIR) -lfastsasconvert @STRIP_FLAGS@

CARGO_BUILD_ARGS = --lib --release --manifest-path=$(CURDIR)/rust/Cargo.toml --target-dir $(TARGET_DIR)

# Cargo is invoked from `rust/` rather than from here so that it finds
# `../.cargo/config.toml` by walking up. That file's `[patch.crates-io]` redirect is
# what points `sas7bdat`/`sas7bdat-convert` at this checkout instead of at the
# published crates; `.Rbuildignore` strips it, so a tarball resolves the real
# published versions. Running cargo from `src/` would find it too, but `rust/` is
# also where the vendored dependencies land (below), so everything cargo reads stays
# in one place.
#
# There is deliberately no `rust-toolchain.toml` in this package. It used to pin an
# exact nightly, because the core needed `#![feature(portable_simd)]`; since the core
# moved to `fearless_simd` it builds on stable, and the pin became both unnecessary
# and actively harmful — rustup would try to *download* the pinned toolchain, which a
# CRAN build machine cannot do. With no pin, a tarball uses whatever rustc is
# installed, and inside the repository the root pin still applies.

$(SHLIB): $(STATLIB)

# FORCE, not a bare rule. Without it make treats an existing archive as up to date
# — it has no prerequisites, so nothing tells make the Rust sources changed — and
# silently links the stale one. Cargo already does its own up-to-date check.
#
# The vendor step is what makes an offline build possible. CRAN builds with no
# network, so a released tarball carries every dependency's source in
# `rust/vendor.tar.xz` (see `scripts/vendor-r-package.sh`). When that file is present
# it is unpacked and cargo is told to resolve from it and never reach the network;
# when it is absent — any build from the repository — cargo resolves normally.
#
# The two restrictions below apply only on the vendored path, which is exactly the
# path a released tarball takes, and they are both CRAN requirements:
#
#   CARGO_HOME  cargo writes its registry cache and git checkouts to ~/.cargo by
#               default. CRAN forbids writing anywhere outside the build directory,
#               so it is redirected under `target/`, which `clean` already removes.
#   --jobs 2    cargo ignores make's `-j` and spawns one job per logical CPU, which
#               oversubscribes a shared build machine. CRAN asks for at most two.
#
# Neither is applied when building from the repository, where there is no tarball:
# a fresh CARGO_HOME would re-download the whole registry on every install, and
# capping a developer's cores at two is a cost with nothing to buy.
$(STATLIB): FORCE
	# `R CMD check` fails "checking Rust compilation" with "No rustc version
	# reported prior to compilation" unless the toolchain identifies itself in the
	# install log. CRAN wants this on record for every Rust package.
	rustc --version && cargo --version
	if [ -f rust/vendor.tar.xz ]; then \
	  tar -xf rust/vendor.tar.xz -C rust && \
	  mkdir -p rust/.cargo && \
	  printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "vendor"\n' > rust/.cargo/config.toml; \
	fi
	cd rust && \
	  if [ -d vendor ]; then \
	    CARGO_HOME="$(TARGET_DIR)/cargo-home" && export CARGO_HOME && \
	    mkdir -p "$$CARGO_HOME" && \
	    cargo build $(CARGO_BUILD_ARGS) --offline --jobs 2; \
	  else \
	    cargo build $(CARGO_BUILD_ARGS); \
	  fi

C_clean:
	rm -Rf $(LIBDIR)/build

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) rust/target rust/vendor rust/.cargo

FORCE:

.PHONY: C_clean clean FORCE
