\name{sas_columns}
\alias{sas_columns}
\title{Name and type the columns that convert_sas() writes}
\usage{
sas_columns(
  names = c("asis", "lower", "upper"),
  rename = NULL,
  add = NULL,
  source_column = NULL,
  strings = c("string", "large_string"),
  timestamps = NULL,
  times = NULL,
  time_unit = NULL
)
}
\arguments{
\item{names}{Case of the written column names: \code{"asis"} (default),
\code{"lower"} or \code{"upper"}. \code{rename} overrides it for the columns it names.}

\item{rename}{A named character vector, \code{c(OLD = "new")}, writing column
\code{OLD} as \code{new}. SAS names are case-insensitive, so \code{OLD} matches whatever
case the file uses. A name that matches no column fails that file.}

\item{add}{A named character vector of constant columns, appended after the
file's own, holding the same value in every row.}

\item{source_column}{Name of a constant column holding the input file's path,
as given to \code{\link[=convert_sas]{convert_sas()}}. \code{NULL} adds none.}

\item{strings}{Arrow type of text columns in Parquet: \code{"string"} (default)
or \code{"large_string"}.}

\item{timestamps}{Unit of timestamps in Parquet: \code{"s"}, \code{"ms"}, \code{"us"} or
\code{"ns"}. \code{NULL} (default) keeps microseconds. A coarser unit rounds each
instant down, towards the past.}

\item{times}{How SAS times are written in Parquet. \code{NULL} (default) and
\code{"duration"} keep elapsed times, which may exceed a day, but readers other
than Arrow see them as integers. \code{"time_of_day"} writes Parquet's \code{TIME},
which DuckDB and others read as a time, and fails a file holding a value
outside one day.}

\item{time_unit}{Unit for \code{times}: \code{"s"}, \code{"ms"}, \code{"us"} or \code{"ns"}. Defaults
to \code{"ns"} for durations and \code{"ms"} for times of day.}
}
\value{
An object to pass as \code{columns}.
}
\description{
Builds the \code{columns} argument of \code{\link[=convert_sas]{convert_sas()}}. The rules apply to every
file in a run, so one call fits files with different columns.
}
\details{
Two written columns may not share a name. A rule that would give
them one fails that file, with both source columns named in \code{error}.
\code{strings}, \code{timestamps} and \code{times} apply only to Parquet, and a CSV or TSV
run that sets them fails.
}
\examples{
sas_columns(names = "lower", source_column = "source_file")
sas_columns(rename = c(PNR = "person_id"), times = "time_of_day")
}
