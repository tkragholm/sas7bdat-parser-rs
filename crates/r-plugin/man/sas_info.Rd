% Generated by hand to mirror roxygen2 output; keep in sync with the roxygen
% block above `sas_info()` in R/info.R.
\name{sas_info}
\alias{sas_info}
\title{Facts about a SAS7BDAT file, without reading its rows}
\usage{
sas_info(path, catalog = NULL, encoding = NULL)
}
\arguments{
\item{path}{Path to a \code{.sas7bdat} file.}

\item{catalog}{Optional path to a \code{.sas7bcat} value-label catalog.}

\item{encoding}{Read the file's text in this encoding instead of the one its
header declares; see \code{\link[=read_sas7bdat]{read_sas7bdat()}}.}
}
\value{
A list with \code{n_rows} (the rows \code{\link[=read_sas7bdat]{read_sas7bdat()}}
returns, rows SAS marked as deleted excluded), \code{n_deleted_rows},
\code{n_columns}, \code{encoding}, \code{compression}, \code{table_name},
\code{file_label}, \code{created} and \code{modified} (UTC date-times from the
header), and \code{columns}: a data frame with one row per column and the
columns \code{name}, \code{label}, \code{format} (as haven's \code{format.sas}
attribute spells it), \code{type} (the R class it is read as) and \code{width}
in bytes.
}
\description{
Reads the file header and metadata only, which is fast on any file size.
The \code{columns} element lists each variable with its label and SAS format,
as \code{PROC CONTENTS} does.
}
\examples{
info <- sas_info(system.file("extdata", "dtdate.sas7bdat", package = "fastsas"))
info$n_rows
info$columns
}
