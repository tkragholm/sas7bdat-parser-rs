% Generated by hand to mirror roxygen2 output; keep in sync with the roxygen
% block above `read_sas7bdat()` in R/read_sas.R.
\name{read_sas7bdat}
\alias{read_sas7bdat}
\alias{read_sas}
\title{Read a SAS7BDAT file}
\usage{
read_sas7bdat(path, catalog = NULL, categorical = FALSE)

read_sas(path, catalog = NULL, categorical = FALSE)
}
\arguments{
\item{path}{Path to a \code{.sas7bdat} file.}

\item{catalog}{Optional path to a \code{.sas7bcat} value-label catalog. If
\code{NULL} (the default), a same-stem \code{.sas7bcat} sibling next to
\code{path} is used when present.}

\item{categorical}{If \code{TRUE}, plain (non-value-labelled) character columns
are returned as \code{factor} instead of \code{character}. This is faster to
build and uses less memory on low-cardinality columns, and speeds up
downstream grouping/joining. Default \code{FALSE} (haven-style
\code{character}).}
}
\value{
A tibble (or a base \code{data.frame} if the \pkg{tibble} package is not
installed).
}
\description{
Reads a \code{.sas7bdat} file into a data frame using the Rust parsing core.
Column types follow \pkg{haven} conventions: SAS numerics become
\code{double}, character columns become UTF-8 \code{character}, SAS dates
become \code{Date}, datetimes become \code{POSIXct} (UTC), and times become
\code{hms}.
}
\details{
SAS variable labels are attached as the column \code{label} attribute, with any
surrounding whitespace preserved exactly as \pkg{haven} reports it. When a
value-label catalog is available, labelled columns are returned as
\code{haven_labelled} vectors (a \code{labels} named vector plus the
haven/vctrs class).

SAS special missing values (\code{.A}-\code{.Z}, \code{._}) become
\code{\link[haven]{tagged_na}} values on every numeric and temporal column.
}
\section{Name clash with haven}{

\pkg{haven} also exports a \code{read_sas()}, so whichever package is attached
second masks the other and \code{library(fastsas); library(haven)} silently
changes which one \code{read_sas()} means. \code{read_sas7bdat()} is the same
function under a name nothing else claims; prefer it in scripts, or qualify the
call as \code{fastsas::read_sas()}.
}

\section{Text encoding}{

Files that declare a single-byte Western encoding are decoded as Windows-1252
rather than strict ISO-8859-1. The two agree everywhere except bytes
\code{0x80}-\code{0x9F}, which ISO-8859-1 leaves as control characters and which
real SAS-on-Windows files use for curly quotes, dashes and the euro sign.
\pkg{haven} decodes those as controls, so the two packages differ on exactly
those bytes.
}

\examples{
\dontrun{
df <- read_sas7bdat("path/to/file.sas7bdat")
df <- read_sas7bdat("data.sas7bdat", catalog = "formats.sas7bcat")
df <- read_sas7bdat("survey.sas7bdat", categorical = TRUE)
}
}
