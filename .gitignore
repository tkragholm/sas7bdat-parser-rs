# Rust build artifacts (root and nested workspace members)
target/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# macOS
.DS_Store

# Test fixtures (binary data files, tracked via README only)
fixtures/*
!fixtures/README.md

# Local dev / tooling caches
.indxr-cache/
/.quibble
fixtures/fixture_catalog.local.json
INDEX.md

# Personal editor / AI assistant configs (not project-level)
.claude/
.codex/
.mcp.json

# Reference implementation
old-implementation/

# These lockfiles are deliberately tracked: the R packages ship theirs inside the
# package, CI checks them with `--locked`, and the workspace lock pins the build.
# Negated here because a contributor may well have `Cargo.lock` in a global
# gitignore -- which silently omitted one of these when this package was added.
!Cargo.lock
